# Leave NEXT_PUBLIC_API_URL unset to use same-origin /api/v1 (Next.js rewrites to Django).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8005/api/v1
# Optional: force absolute media URLs; otherwise the app uses same-origin /media (rewritten).
# NEXT_PUBLIC_MEDIA_ORIGIN=http://127.0.0.1:8005
NEXT_PUBLIC_DEFAULT_CURRENCY=GBP
# Server-side fetches (RSC): loopback avoids localhost vs 127.0.0.1 issues on Windows.
INTERNAL_API_URL=http://127.0.0.1:8005/api/v1
# Optional override if Django runs elsewhere (must match next.config rewrites BACKEND_ORIGIN).
# BACKEND_ORIGIN=http://127.0.0.1:8005

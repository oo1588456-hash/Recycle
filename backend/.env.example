SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DEFAULT_CURRENCY=GBP
GEMINI_API_KEY=your-gemini-api-key-here
USE_GEMINI_AI=True
GEMINI_MODEL=gemini-2.0-flash
# Optional: dissertation-aligned GPT vision (tried before Gemini when key is set and USE_OPENAI_AI is not "false")
OPENAI_API_KEY=
USE_OPENAI_AI=
OPENAI_MODEL=gpt-4o-mini
DATASETS_DIR=../datasets
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Next.js server-side fetches (SSR) — use loopback to avoid localhost/IPv6 mismatches
INTERNAL_API_URL=http://127.0.0.1:8005/api/v1
